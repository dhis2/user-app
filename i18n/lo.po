msgid "There was an error disabling the user: {{- error}}"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການປິດໃຊ້ງານຜູ້ໃຊ້: {{- error}}"

msgid "Disable user {{- name}}"
msgstr "ປິດໃຊ້ງານຜູ້ໃຊ້ {{- name}}"

msgid "Are you sure you want to disable {{- name}}?"
msgstr "ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຕ້ອງການປິດໃຊ້ງານ {{- name}}?"

msgid "Yes, disable"
msgstr "ແມ່ນ, ປິດໃຊ້ງານ"

msgid "User \"{{- name}}\" enabled successfuly"
msgstr "ເປີດການໃຊ້ງານຜູ້ໃຊ້ \"{{- name}}\" ສຳເລັດແລ້ວ"

msgid "There was an error enabling the user: {{- error}}"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເປີດໃຊ້ງານຜູ້ໃຊ້: {{- error}}"

msgid "Enable user {{- name}}"
msgstr "ເປີດໃຊ້ງານຜູ້ໃຊ້ {{- name}}"

msgid "Are you sure you want to enable {{- name}}?"
msgstr "ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຕ້ອງການເປີດໃຊ້ງານ {{- name}}?"

msgid "Yes, enable"
msgstr "ແມ່ນ, ເປີດໃຊ້ງານ"

msgid "User \"{{- name}}\" replicated successfuly"
msgstr "ເຮັດສຳເນົາຜູ້ໃຊ້ \"{{- name}}\" ສຳເລັດແລ້ວ"

msgid "There was an error replicating the user: {{- error}}"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເຮັດສຳເນົາຜູ້ໃຊ້: {{- error}}"

msgid "Replicate user {{- name}}"
msgstr "ເຮັດສຳເນົາຜູ້ໃຊ້ {{- name}}"

msgid "Username for new user"
msgstr "ຊື່ຜູ້ໃຊ້ສຳລັບຜູ້ໃຊ້ໃໝ່"

msgid "Password for new user"
msgstr "ລະຫັດຜ່ານສຳລັບຜູ້ໃຊ້ໃໝ່"

msgid "Cancel"
msgstr "Cancel"

msgid "Replicate user"
msgstr "ສຳເນົາຜູ້ໃຊ້"

msgid "Password of user \"{{- name}}\" reset successfuly"
msgstr "ຕັ້ງລະຫັດຜ່ານຂອງຜູ້ໃຊ້ \"{{- name}}\" ໃໝ່ສຳເລັດແລ້ວ"

msgid "There was an error resetting the password: {{- error}}"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຕັ້ງລະຫັດຜ່ານໃໝ່: {{- error}}"

msgid "Are you sure you want to reset the password for {{- name}}?"
